# Auto detect text files and perform LF normalization
* text=auto

# Dokumente
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf

# Web Assets
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.svg text eol=lf

# Scripts
*.sh text eol=lf
*.ps1 text eol=crlf working-tree-encoding=UTF-8

# YAML
*.yml text eol=lf
*.yaml text eol=lf

# Git config
.gitattributes text eol=lf
.gitignore text eol=lf
.gitkeep text eol=lf

# GitHub
.github/** text eol=lf

# Binary Dateien
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary

# Font Dateien
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Export diff für spezielle Dateien
*.lockb binary
package-lock.json binary linguist-generated=true
yarn.lock binary linguist-generated=true

# Linguist Overrides - für GitHub language statistics
*.md linguist-detectable=true
docs/** linguist-documentation=true
automations/**/demo-files/** linguist-vendored=false
automations/**/example-code/** linguist-vendored=false
